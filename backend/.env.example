# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — this repository is public.
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_KEYS needs four comma-separated values:
#   node -e "console.log(Array.from({length:4},()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
#
# Use DIFFERENT values locally and in production.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# Production only: the public Railway domain, no trailing slash.
# PUBLIC_URL=https://your-app.up.railway.app
# Production behind Railway's TLS-terminating proxy. Leave false locally.
PROXY_KOA=false

# --- Secrets --------------------------------------------------------------
APP_KEYS=                 # 4 comma-separated keys — signs cookies
API_TOKEN_SALT=           # salts API tokens
ADMIN_JWT_SECRET=         # signs ADMIN PANEL logins
TRANSFER_TOKEN_SALT=      # data import/export tokens
JWT_SECRET=               # signs APP USER logins (students, instructors) — not the same as above
ENCRYPTION_KEY=           # encrypts stored token values (required in Strapi 5)

# --- Database -------------------------------------------------------------
# Local: sqlite is fine (zero setup).
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production (Railway): Postgres. Railway's managed certificate is not in the
# public trust chain, so verification must be disabled — the connection is
# still encrypted, it just isn't verified against a public CA.
# DATABASE_CLIENT=postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Cross-origin ---------------------------------------------------------
# The frontend origin allowed to call this API. No trailing slash.
FRONTEND_URL=http://localhost:3000

# --- Seeding --------------------------------------------------------------
# Creates demo users/courses/lessons/quizzes on boot, only when the database is
# empty. Set to false once production has been seeded once.
SEED_DEMO_DATA=true
SEED_PASSWORD=Passw0rd!
