{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "A lesson inside a course. Content is either text or a video URL."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "contentType": {
      "type": "enumeration",
      "enum": [
        "text",
        "video"
      ],
      "default": "text",
      "required": true
    },
    "body": {
      "type": "text"
    },
    "videoUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "required": true
    },
    "durationMinutes": {
      "type": "integer",
      "min": 0
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "lessons"
    },
    "progresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lesson-progress.lesson-progress",
      "mappedBy": "lesson"
    }
  }
}
