{
  "kind": "collectionType",
  "collectionName": "notifications",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Notification"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "recipient": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["payment_approved", "payment_rejected", "blog_published", "enrollment_request", "instructor_request"],
      "required": true
    },
    "title": { "type": "string", "required": true, "maxLength": 120 },
    "message": { "type": "string", "required": true, "maxLength": 240 },
    "href": { "type": "string", "required": true, "maxLength": 300 },
    "sourceKey": { "type": "string", "maxLength": 160 },
    "readAt": { "type": "datetime" }
  }
}
