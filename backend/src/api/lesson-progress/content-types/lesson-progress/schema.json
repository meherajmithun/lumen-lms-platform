{
  "kind": "collectionType",
  "collectionName": "lesson_progresses",
  "info": {
    "singularName": "lesson-progress",
    "pluralName": "lesson-progresses",
    "displayName": "Lesson Progress",
    "description": "One row per completed lesson per student. `course` is denormalised so course progress is two counts, not a join walk."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lesson.lesson",
      "inversedBy": "progresses"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course"
    },
    "completedAt": {
      "type": "datetime",
      "required": true
    }
  }
}
